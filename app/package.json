{
  "name": "premier-geste",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Guide pas à pas des gestes qui sauvent — PWA hors ligne",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "audio": "node scripts/gen-audio.mjs",
    "e2e": "playwright test",
    "capture": "node scripts/capture.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^3.2.0"
  }
}
